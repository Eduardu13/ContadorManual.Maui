<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContadorManual.Maui.Views.MainPage"
             Title="Contador Manual">

    <VerticalStackLayout 
        Spacing="16"
        Margin="12"
        Padding="16">
        <Label Text="Conteo:"
               HorizontalOptions="Fill"
               FontSize="Medium"/>
        <Border
            Stroke="Gray"
            StrokeThickness="2">
            <Label Text="{Binding Path=Conteo}"
                   Padding="0,36"
                   FontSize="Large"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   />
        </Border>

        <HorizontalStackLayout
            Spacing="5"
            >

            <Label
                Text="El conteo incremetneara por:"
                VerticalOptions="Center"
                FontSize="Medium"
                />

            <Entry
                Text="{Binding Source={x:Reference IncrementoStepper}, Path=Value}"
                IsReadOnly="True"
                />
                <!--Enlace de datos-->
            
            
            <Stepper
                Minimum="1"
                Maximum="20"
                Value="{Binding Path=Incremento}"
                Increment="1"
                
                x:Name="IncrementoStepper"
                
                
                />
            <!--ValueChanged="OnIncrementoStepperValueChanged"-->

        </HorizontalStackLayout>
        
        <HorizontalStackLayout
            HorizontalOptions="Center" 
            Spacing="24"
            Margin="0,24,0,0">
            <Button Text="Contar"
                    Clicked="OnContarButtonClicked"/>
            <Button Text="Reiniciar"
                    Clicked="OnReiniciarButtonClicked"/>
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>